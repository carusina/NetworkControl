<Window x:Class="Gui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Gui.Views"
        Title="NetworkControl GUI" Height="760" Width="1300" ResizeMode="CanMinimize">
    <Window.Resources>
        <!-- 레이더 느낌의 배경 격자 - 40px 타일을 반복해서 그림 -->
        <DrawingBrush x:Key="RadarGridBrush" TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#1A00FFAA" Thickness="1"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="40,0"/>
                            <LineGeometry StartPoint="0,0" EndPoint="0,40"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="640"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 연결/조종/통계 패널 -->
        <StackPanel Grid.Column="0" Margin="0,0,10,0">

            <GroupBox Header="연결">
                <StackPanel Margin="4">
                    <TextBlock Text="Host"/>
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsConnected, Converter={x:Static local:InverseBooleanConverter.Instance}}"/>
                    <TextBlock Text="TCP Port" Margin="0,4,0,0"/>
                    <TextBox Text="{Binding TcpPortText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsConnected, Converter={x:Static local:InverseBooleanConverter.Instance}}"/>
                    <TextBlock Text="UDP Port (수신)" Margin="0,4,0,0"/>
                    <TextBox Text="{Binding UdpPortText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsConnected, Converter={x:Static local:InverseBooleanConverter.Instance}}"/>
                    <TextBlock Text="Server UDP Port" Margin="0,4,0,0"/>
                    <TextBox Text="{Binding ServerUdpPortText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsConnected, Converter={x:Static local:InverseBooleanConverter.Instance}}"/>
                    <Button Content="Connect" Command="{Binding ConnectCommand}" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Margin="0,4,0,0"/>
                    <TextBlock Margin="0,4,0,0">
                        <Run Text="내 엔티티 ID: "/>
                        <Run Text="{Binding MyEntityIdText, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0" FontFamily="Consolas">
                        <Run Text="좌표: "/>
                        <Run Text="{Binding MyPositionText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="재생 제어" Margin="0,10,0,0">
                <StackPanel Margin="4">
                    <UniformGrid Columns="2" Rows="2">
                        <Button Content="Play" Command="{Binding PlayCommand}" Margin="2">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlayActive}" Value="True">
                                            <Setter Property="Background" Value="LightGreen"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Pause" Command="{Binding PauseCommand}" Margin="2">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPauseActive}" Value="True">
                                            <Setter Property="Background" Value="Orange"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Stop" Command="{Binding StopCommand}" Margin="2">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStopActive}" Value="True">
                                            <Setter Property="Background" Value="LightCoral"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Reset" Command="{Binding ResetCommand}" Margin="2"/>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,4,0,0">
                        <Button Content="30Hz" Command="{Binding SetRate30Command}" Margin="2">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRate30Active}" Value="True">
                                            <Setter Property="Background" Value="LightSkyBlue"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="60Hz" Command="{Binding SetRate60Command}" Margin="2">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRate60Active}" Value="True">
                                            <Setter Property="Background" Value="LightSkyBlue"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </UniformGrid>
                    <TextBlock Margin="0,6,0,0" FontWeight="Bold">
                        <Run Text="현재: "/>
                        <Run Text="{Binding PlayStateText, Mode=OneWay}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding DataRateText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="조종" Margin="0,10,0,0">
                <StackPanel Margin="4">
                    <TextBlock Text="{Binding Throttle, StringFormat='Throttle: {0:F2}'}"/>
                    <Slider Minimum="-1" Maximum="1" Value="{Binding Throttle, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.1"/>
                    <TextBlock Text="{Binding Yaw, StringFormat='Yaw: {0:F2}'}" Margin="0,8,0,0"/>
                    <Slider Minimum="-1" Maximum="1" Value="{Binding Yaw, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.1"/>
                </StackPanel>
            </GroupBox>

        </StackPanel>

        <!-- 가운데: 고정 배율 전체 맵 뷰 (레이더/HUD 스타일) -->
        <Border Grid.Column="1" BorderBrush="#FF00FFAA" BorderThickness="1" Background="#FF05080A"
                Width="640" Height="640" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid Width="640" Height="640" ClipToBounds="True">
                <Rectangle Fill="{StaticResource RadarGridBrush}"/>

                <!-- 링/십자선 = 내 기수 기준 상대 방위(전방/후방/좌/우) 기준선이라 화면에 고정 -
                     회전은 엔티티 쪽(EntityViewModel)에서 상대 방위를 계산할 때만 적용됨 -->
                <Ellipse Width="160" Height="160" Stroke="#3300FFAA" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Width="320" Height="320" Stroke="#3300FFAA" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Width="480" Height="480" Stroke="#3300FFAA" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Width="600" Height="600" Stroke="#3300FFAA" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Line X1="320" Y1="0" X2="320" Y2="640" Stroke="#2200FFAA" StrokeThickness="1"/>
                <Line X1="0" Y1="320" X2="640" Y2="320" Stroke="#2200FFAA" StrokeThickness="1"/>

                <Canvas>
                    <ItemsControl ItemsSource="{Binding Entities}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}"/>
                                <Setter Property="Canvas.Top" Value="{Binding CanvasTop}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 헬기 모양 화살촉 - 뾰족한 코가 진행 방향(Heading)을 가리킴 -->
                                <Polygon Points="16,8 2,2 7,8 2,14">
                                    <Polygon.RenderTransform>
                                        <RotateTransform Angle="{Binding HeadingDegrees}" CenterX="8" CenterY="8"/>
                                    </Polygon.RenderTransform>
                                    <Polygon.Style>
                                        <Style TargetType="Polygon">
                                            <Setter Property="Fill" Value="Cyan"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="Cyan" BlurRadius="14" ShadowDepth="0" Opacity="0.9"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="Fill" Value="OrangeRed"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="OrangeRed" BlurRadius="16" ShadowDepth="0" Opacity="1"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Polygon.Style>
                                </Polygon>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>

                <!-- 미니맵: 메인 레이더와 달리 회전/카메라 추적 없이 월드 원점(0,0) 기준
                     절대 좌표를 그대로 보여줌 - "내가 원점에서 얼마나 떨어졌는지"를 감으로 보는 용도 -->
                <Border Width="150" Height="150" Background="#DD05080A" BorderBrush="#FF00FFAA" BorderThickness="1"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8">
                    <Grid Width="150" Height="150" ClipToBounds="True">
                        <Line X1="75" Y1="0" X2="75" Y2="150" Stroke="#5500FFAA" StrokeThickness="1"/>
                        <Line X1="0" Y1="75" X2="150" Y2="75" Stroke="#5500FFAA" StrokeThickness="1"/>

                        <!-- 200 월드 단위 간격 눈금 -->
                        <Line X1="37.5" Y1="72" X2="37.5" Y2="78" Stroke="#5500FFAA" StrokeThickness="1"/>
                        <Line X1="112.5" Y1="72" X2="112.5" Y2="78" Stroke="#5500FFAA" StrokeThickness="1"/>
                        <Line X1="72" Y1="37.5" X2="78" Y2="37.5" Stroke="#5500FFAA" StrokeThickness="1"/>
                        <Line X1="72" Y1="112.5" X2="78" Y2="112.5" Stroke="#5500FFAA" StrokeThickness="1"/>

                        <TextBlock Text="±400" FontSize="9" Foreground="Gray" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,3,0"/>
                        <!-- 미니맵은 메인 레이더와 달리 회전하지 않는 고정 절대좌표 뷰라는 것을 텍스트로 안내
                             (예전엔 축을 메인 레이더에 우연히 맞춰뒀었는데, 그 대신 표준 축 + 이 안내로 바꿈) -->
                        <TextBlock Text="고정(회전 없음)" FontSize="9" Foreground="Gray" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3,0,0,2"/>

                        <Canvas>
                            <ItemsControl ItemsSource="{Binding Entities}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding MinimapLeft}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding MinimapTop}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="6" Height="6">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="Cyan"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                            <Setter Property="Fill" Value="OrangeRed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 오른쪽: 수신 통계 상세 (MetricsSnapshot 전체 필드) -->
        <StackPanel Grid.Column="2" Margin="10,0,0,0">

            <GroupBox Header="수신량 / 유실">
                <StackPanel Margin="4">
                    <TextBlock Text="{Binding Metrics.ElapsedSeconds, StringFormat='경과 시간: {0:F1}초'}"/>
                    <TextBlock Text="{Binding Metrics.TotalReceivedCount, StringFormat='총 수신 패킷: {0}'}"/>
                    <TextBlock Text="{Binding Metrics.LossCount, StringFormat='유실 패킷: {0}'}"/>
                    <TextBlock Text="{Binding Metrics.LossRate, StringFormat='유실률: {0:F2}%'}"/>
                    <TextBlock Text="{Binding Metrics.OutOfOrderCount, StringFormat='순서 역전: {0}'}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="수신 간격" Margin="0,10,0,0">
                <StackPanel Margin="4">
                    <TextBlock Text="{Binding Metrics.IntervalSampleCount, StringFormat='샘플 수: {0}'}"/>
                    <TextBlock Text="{Binding Metrics.AverageReceiveIntervalMilliseconds, StringFormat='평균 간격: {0:F1} ms'}"/>
                    <TextBlock Text="{Binding Metrics.MaxReceiveIntervalMilliseconds, StringFormat='최대 간격: {0:F1} ms'}"/>
                    <TextBlock Text="{Binding Metrics.AverageIntervalDeviationMilliseconds, StringFormat='평균 편차: {0:F1} ms'}"/>
                    <TextBlock Text="{Binding Metrics.DelayedPacketCount, StringFormat='지연 패킷 수: {0}'}"/>
                    <TextBlock Text="{Binding Metrics.DelayedPacketRate, StringFormat='지연 패킷 비율: {0:F2}%'}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="지연(Latency)" Margin="0,10,0,0">
                <StackPanel Margin="4">
                    <TextBlock Text="{Binding Metrics.LatencySampleCount, StringFormat='샘플 수: {0}'}"/>
                    <TextBlock Text="{Binding Metrics.AverageLatencyMilliseconds, StringFormat='평균 지연: {0:F1} ms'}"/>
                    <TextBlock Text="{Binding Metrics.MinLatencyMilliseconds, StringFormat='최소 지연: {0:F1} ms'}"/>
                    <TextBlock Text="{Binding Metrics.MaxLatencyMilliseconds, StringFormat='최대 지연: {0:F1} ms'}"/>
                    <TextBlock Text="같은 PC에서 실행할 때만 유효" Margin="0,4,0,0" FontStyle="Italic" Foreground="Gray"/>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </Grid>
</Window>
